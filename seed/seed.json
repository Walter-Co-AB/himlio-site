{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Himlio",
    "description": "Startinnehåll för en Himlio-sajt: en samling för sidor och en huvudmeny.",
    "author": "Walter & Co"
  },
  "collections": [
    {
      "slug": "pages",
      "label": "Sidor",
      "labelSingular": "Sida",
      "urlPattern": "/{slug}",
      "supports": ["drafts", "revisions", "preview", "search", "seo"],
      "fields": [
        {
          "slug": "title",
          "label": "Rubrik",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Innehåll",
          "type": "portableText",
          "searchable": true
        }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Huvudmeny",
      "items": [{ "type": "custom", "label": "Start", "url": "/" }]
    }
  ]
}
