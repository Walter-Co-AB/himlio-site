---
import { himlio, telHref } from '../lib/himlio';

const { email, phone, address, org_number } = himlio.contact;
---

{(email || phone || address || org_number) && (
  <dl class="contact">
    {email && (
      <div>
        <dt>E-post</dt>
        <dd>
          <a href={`mailto:${email}`}>{email}</a>
        </dd>
      </div>
    )}
    {phone && (
      <div>
        <dt>Telefon</dt>
        <dd>
          <a href={telHref(phone)}>{phone}</a>
        </dd>
      </div>
    )}
    {address && (
      <div>
        <dt>Adress</dt>
        <dd class="address">{address}</dd>
      </div>
    )}
    {org_number && (
      <div>
        <dt>Org.nr</dt>
        <dd>{org_number}</dd>
      </div>
    )}
  </dl>
)}

<style>
  .contact {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  dt {
    font-size: 0.875rem;
    opacity: 0.7;
  }
  dd {
    margin: 0;
  }
  .address {
    white-space: pre-line;
  }
</style>
