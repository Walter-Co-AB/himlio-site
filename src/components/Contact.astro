---
import { telHref, type ContactDetails } from '../lib/contact';

interface Props {
  details: ContactDetails;
}

const { email, phone, address, org_number, opening_hours } = Astro.props.details;
---

{(email || phone || address || org_number || opening_hours) && (
  <dl class="contact">
    {email && (
      <div>
        <dt>E-post</dt>
        <dd>
          <a href={`mailto:${email}`}>{email}</a>
        </dd>
      </div>
    )}
    {phone && (
      <div>
        <dt>Telefon</dt>
        <dd>
          <a href={telHref(phone)}>{phone}</a>
        </dd>
      </div>
    )}
    {address && (
      <div>
        <dt>Adress</dt>
        <dd class="multiline">{address}</dd>
      </div>
    )}
    {opening_hours && (
      <div>
        <dt>Öppettider</dt>
        <dd class="multiline">{opening_hours}</dd>
      </div>
    )}
    {org_number && (
      <div>
        <dt>Org.nr</dt>
        <dd>{org_number}</dd>
      </div>
    )}
  </dl>
)}

<style>
  .contact {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  dt {
    font-size: 0.875rem;
    opacity: 0.7;
  }
  dd {
    margin: 0;
  }
  .multiline {
    white-space: pre-line;
  }
</style>
