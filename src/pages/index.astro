---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageContent from '../components/PageContent.astro';
import { HOME_ID } from '../lib/content';

const page = await getEntry('pages', HOME_ID);
if (!page) throw new Error(`The home page src/content/pages/${HOME_ID}/index.md is missing`);
---

<Base title={page.data.title} description={page.data.description}>
  <PageContent page={page} />
</Base>
