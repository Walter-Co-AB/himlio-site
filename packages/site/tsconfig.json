{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": ["@cloudflare/workers-types", "astro/client", "node"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": [
    "src/emdash/ui.js",
    "src/emdash/ui.d.ts",
    "src/forms/index.js",
    "src/forms/index.d.ts",
    "src/forms/plugin.js",
    "src/forms/plugin.d.ts",
    "src/booking/astro",
    "src/site/astro"
  ]
}
