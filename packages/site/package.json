{
  "name": "@himlio/site",
  "version": "1.10.0",
  "description": "The Himlio platform for an EmDash site: Astro integration, Worker runtime and build tooling.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walter-Co-AB/himlio-site.git",
    "directory": "packages/site"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "files": [
    "dist",
    "cli",
    "migrations",
    "model-migrations",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "himlio-site": "cli/himlio-site.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./worker": {
      "types": "./dist/runtime/worker.d.ts",
      "default": "./dist/runtime/worker.js"
    },
    "./middleware": {
      "types": "./dist/runtime/middleware.d.ts",
      "default": "./dist/runtime/middleware.js"
    },
    "./session-driver": {
      "types": "./dist/runtime/session-d1.d.ts",
      "default": "./dist/runtime/session-d1.js"
    },
    "./emdash": {
      "types": "./dist/emdash/index.d.ts",
      "default": "./dist/emdash/index.js"
    },
    "./emdash/ui": {
      "types": "./dist/emdash/ui.d.ts",
      "default": "./dist/emdash/ui.js"
    },
    "./emdash/page": {
      "types": "./dist/emdash/page.d.ts",
      "default": "./dist/emdash/page.js"
    },
    "./emdash/runtime": {
      "types": "./dist/emdash/runtime.d.ts",
      "default": "./dist/emdash/runtime.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./forms/plugin": {
      "types": "./dist/forms/plugin.d.ts",
      "default": "./dist/forms/plugin.js"
    },
    "./booking/plugin": {
      "types": "./dist/booking/plugin.d.ts",
      "default": "./dist/booking/plugin.js"
    },
    "./booking": {
      "types": "./dist/booking/astro/ui.d.ts",
      "default": "./dist/booking/astro/ui.js"
    },
    "./booking/astro": {
      "types": "./dist/booking/astro/index.d.ts",
      "default": "./dist/booking/astro/index.js"
    },
    "./booking/client": {
      "types": "./dist/booking/client.d.ts",
      "default": "./dist/booking/client.js"
    },
    "./booking/admin": {
      "types": "./dist/booking/admin.d.ts",
      "default": "./dist/booking/admin.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/emdash/ui.js src/emdash/ui.d.ts dist/emdash/ && mkdir -p dist/forms && cp src/forms/index.js src/forms/index.d.ts src/forms/plugin.js src/forms/plugin.d.ts dist/forms/ && mkdir -p dist/booking/astro && cp src/booking/astro/* dist/booking/astro/",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@cloudflare/kumo": "2.15.0",
    "@emdash-cms/cloudflare": "1.5.0",
    "@emdash-cms/plugin-forms": "0.2.13",
    "emdash": "1.5.0",
    "ical.js": "2.2.1",
    "kysely": "0.29.9",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wrangler": "^4.162.0"
  },
  "peerDependencies": {
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "astro": "^7.4.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
