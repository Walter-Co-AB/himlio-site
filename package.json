{
  "name": "himlio-site-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/site",
    "starter"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "npm run build -w @himlio/site",
    "test": "npm test -w @himlio/site",
    "verify": "npm run format:check && npm run build && npm test && npm run verify -w himlio-starter",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  }
}
