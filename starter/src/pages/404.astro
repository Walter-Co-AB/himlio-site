---
import Base from "../layouts/Base.astro";
import { t } from "../utils/strings";
---

<Base title={t.notFoundTitle}>
	<section class="container empty-state">
		<p class="display not-found__code">404</p>
		<h1 class="display empty-state__title">{t.notFoundTitle}</h1>
		<p class="lead">
			{t.notFoundText}
		</p>
		<div class="actions">
			<a href="/" class="btn btn-lg">{t.toHomePage}</a>
		</div>
	</section>
</Base>

<style>
	.not-found__code {
		font-size: clamp(120px, 22vw, 240px);
		line-height: 0.85;
		letter-spacing: var(--tracking-tight);
		color: var(--color-muted);
	}
</style>
