---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "@himlio/site/emdash";
import { Image, type BlockComponentProps } from "@himlio/site/emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const { anchor_id, eyebrow, headline, subheadline, image, image_caption, centered } =
	value;
// Himlio: the layout variant ("cover": the text over the image, full bleed). Needs an image.
const cover = value.layout === "cover" && !!image;

const eyebrowUrl = value.eyebrow_url ? sanitizeHref(value.eyebrow_url) : undefined;
const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={[
		"hero",
		{ "hero--centered": centered },
		cover && ["hero--cover", "sheet", "sheet-section", "settle"],
	]}
>
	{
		cover && image && (
			<div class="hero__bg">
				<Image
					image={image}
					alt=""
					priority
					sizes="(max-width: 960px) 1000px, min(100vw, 1680px)"
				/>
			</div>
		)
	}
	<div class="container hero__content">
		{
			eyebrow && eyebrowUrl && (
				<a href={eyebrowUrl} class="hero__announce rise">
					{eyebrow}
					<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
				</a>
			)
		}
		{eyebrow && !eyebrowUrl && <p class="hero__announce rise">{eyebrow}</p>}
		<h1 class="display hero__headline rise">{headline}</h1>
		{
			(subheadline || primaryCta || secondaryCta) && (
				<div class="hero__row rise">
					{subheadline && <p class="lead hero__lead">{subheadline}</p>}
					{(primaryCta || secondaryCta) && (
						<div class="actions">
							{primaryCta && (
								<a
									href={primaryCta.url}
									class:list={["btn", "btn-lg", cover ? "btn-light" : "btn-primary"]}
								>
									{primaryCta.label}
									<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
								</a>
							)}
							{secondaryCta && (
								<a
									href={secondaryCta.url}
									class:list={["btn", "btn-lg", cover ? "btn-glass" : "btn-secondary"]}
								>
									{secondaryCta.label}
								</a>
							)}
						</div>
					)}
				</div>
			)
		}
		{cover && image_caption && <p class="hero__cover-caption">{image_caption}</p>}
	</div>
	{
		image && !cover && (
			<figure class="sheet media settle hero__media">
				<div class="media__img">
					<Image
						image={image}
						priority
						sizes="(max-width: 960px) 178vw, min(100vw, 1680px)"
					/>
				</div>
				{image_caption && (
					<figcaption class="media-chip">
						{image_caption}
					</figcaption>
				)}
			</figure>
		)
	}
</section>

<style>
	.hero {
		padding-block-start: clamp(56px, 7vw, 104px);
	}

	.hero__announce {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 34px;
		padding-block: 6px;
		padding-inline: 14px;
		border-radius: 17px;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		font-size: 13.5px;
		line-height: 1.35;
		color: var(--color-text-secondary);
		transition: box-shadow 160ms var(--ease-out);
	}

	.hero__announce :global(.arrow) {
		flex: none;
		color: var(--color-muted);
	}

	a.hero__announce:hover {
		box-shadow: var(--shadow-card-hover);
	}

	.hero__headline {
		--rise-index: 1;
		max-width: 16ch;
		font-size: var(--font-size-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.hero__announce + .hero__headline {
		margin-block-start: 28px;
	}

	.hero__row {
		--rise-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 32px;
		margin-block-start: 36px;
	}

	.hero__lead {
		max-width: 50ch;
	}

	.hero__media {
		margin-block-start: clamp(48px, 5vw, 72px);
		aspect-ratio: 21 / 9;
		border-radius: var(--radius-sheet);
	}

	.hero--centered .container {
		text-align: center;
	}

	.hero--centered .hero__headline {
		max-width: 18ch;
		margin-inline: auto;
		font-size: clamp(44px, 6.2vw, 88px);
	}

	.hero--centered .hero__row {
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
	}

	.hero--centered .actions {
		justify-content: center;
	}

	/* Himlio: layout "cover", the text over the image (like the photo call to action) */
	.hero--cover {
		display: grid;
		align-items: end;
		min-height: clamp(520px, 72vh, 820px);
		padding-block-start: 0;
		color: #fff;
		background-color: var(--color-night);
	}

	.hero--cover::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			to top,
			rgb(15 14 13 / 0.88),
			rgb(15 14 13 / 0.5) 45%,
			rgb(15 14 13 / 0.1)
		);
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.hero__bg :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		object-fit: cover;
	}

	.hero--cover .hero__content {
		padding-block: clamp(96px, 10vw, 140px) clamp(40px, 5vw, 72px);
	}

	.hero--cover .hero__lead {
		color: rgb(255 255 255 / 0.78);
	}

	.hero--cover .hero__announce {
		background: var(--chip-bg);
		color: var(--chip-text);
	}

	.hero--cover :focus-visible {
		outline-color: var(--color-on-night);
	}

	.hero__cover-caption {
		margin-block-start: 32px;
		font-size: 13.5px;
		color: rgb(255 255 255 / 0.64);
	}

	@media (max-width: 960px) {
		.hero__row {
			grid-template-columns: minmax(0, 1fr);
		}

		.hero__media {
			aspect-ratio: 1;
		}

		.hero--cover {
			min-height: 560px;
		}
	}
</style>
