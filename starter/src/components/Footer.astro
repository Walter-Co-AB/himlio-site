---
// The site footer: logo and tagline, the contact details from the admin's Company details, the
// footer menus, the theme switcher and the wordmark. Data comes from Base.astro.
import { hasContactDetails, telHref, type ContactDetails } from "@himlio/site/runtime";
import type { MenuItem, SiteLogo } from "../utils/site";

interface Props {
	siteTitle: string;
	siteTagline: string;
	siteLogo: SiteLogo;
	contact: ContactDetails;
	columns: { heading?: string; items: MenuItem[] }[];
}

const { siteTitle, siteTagline, siteLogo, contact, columns: footerColumns } = Astro.props;
const year = new Date().getFullYear();
const wordmarkLength = [...siteTitle].length;
---

<footer class="site-footer">
	<div class="container">
		<div class="footer__grid">
			<div class="footer__brand">
				<a href="/" class="footer__logo">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								width={siteLogo.width}
								height={siteLogo.height}
								class="footer__logo-img"
							/>
						) : (
							siteTitle
						)
					}
				</a>
				{siteTagline && <p class="footer__tagline">{siteTagline}</p>}
			</div>
			{
				hasContactDetails(contact) && (
					<div class="footer__column">
						<h2 class="footer__heading">Kontakt</h2>
						<ul class="footer__links">
							{contact.email && (
								<li>
									<a href={`mailto:${contact.email}`} class="footer__link">
										{contact.email}
									</a>
								</li>
							)}
							{contact.phone && (
								<li>
									<a href={telHref(contact.phone)} class="footer__link">
										{contact.phone}
									</a>
								</li>
							)}
							{contact.address && <li class="footer__contact-text">{contact.address}</li>}
							{contact.opening_hours && (
								<li class="footer__contact-text">{contact.opening_hours}</li>
							)}
							{contact.org_number && (
								<li class="footer__contact-text">Org.nr {contact.org_number}</li>
							)}
						</ul>
					</div>
				)
			}
			{
				footerColumns.map((column) => (
					<div class="footer__column">
						{column.heading && <h2 class="footer__heading">{column.heading}</h2>}
						<ul class="footer__links">
							{column.items.map((item) => (
								<li>
									<a
										href={item.url}
										target={item.target}
										rel={item.target ? "noopener noreferrer" : undefined}
										class="footer__link"
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<div class="footer__legal">
			<p>&copy; {year} {siteTitle}. Alla rättigheter förbehållna.</p>
			<div class="theme-switcher" role="group" aria-label="Tema">
				<button
					type="button"
					class="theme-btn"
					data-theme="light"
					aria-pressed="false"
					aria-label="Ljust läge">Ljust</button
				>
				<button
					type="button"
					class="theme-btn"
					data-theme="dark"
					aria-pressed="false"
					aria-label="Mörkt läge">Mörkt</button
				>
				<button
					type="button"
					class="theme-btn"
					data-theme="system"
					aria-pressed="false"
					aria-label="Följ systemet">System</button
				>
			</div>
			<p class="footer__powered">
				Drivs med <a href="https://emdashcms.com">EmDash</a>
			</p>
		</div>
	</div>
	<div
		class="footer__wordmark"
		aria-hidden="true"
		style={`--wordmark-length: ${wordmarkLength}`}
	>
		{siteTitle}
	</div>
</footer>

<script>
	// Theme switcher
	const THEME_REGEX = /theme=([^;]+)/;
	const themeBtns =
		document.querySelectorAll<HTMLButtonElement>(".theme-btn");
	const root = document.documentElement;

	function setTheme(theme: string) {
		const secure = location.protocol === "https:" ? "; Secure" : "";
		if (theme === "system") {
			document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
			root.classList.remove("light", "dark");
		} else {
			document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
			root.classList.remove("light", "dark");
			root.classList.add(theme);
		}
		updateActiveBtn(theme);
	}

	function updateActiveBtn(theme: string) {
		themeBtns.forEach((btn) => {
			const active = btn.dataset.theme === theme;
			btn.classList.toggle("active", active);
			btn.setAttribute("aria-pressed", String(active));
		});
	}

	function getStoredTheme(): string {
		const match = document.cookie.match(THEME_REGEX);
		return match ? match[1] : "system";
	}

	// Initialize - apply stored theme on load
	const storedTheme = getStoredTheme();
	setTheme(storedTheme);

	themeBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			setTheme(btn.dataset.theme || "system");
		});
	});
</script>

<style>
	.site-footer {
		overflow: hidden;
		padding-top: calc(var(--section-space) / 2);
	}

	.footer__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr);
		grid-auto-columns: minmax(0, 1fr);
		grid-auto-flow: column;
		gap: 48px;
	}

	.footer__logo {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 28px;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.footer__logo-img {
		width: auto;
		height: 32px;
		max-width: 180px;
		object-fit: contain;
	}

	.footer__tagline {
		max-width: 30ch;
		margin-top: 14px;
		font-size: 14.5px;
		color: var(--color-muted);
	}

	.footer__contact-text {
		font-size: 14.5px;
		white-space: pre-line;
		color: var(--color-text-secondary);
	}

	.footer__heading {
		margin-bottom: 16px;
		font-size: 13px;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: normal;
		color: var(--color-muted);
	}

	.footer__links {
		display: grid;
		gap: 10px;
	}

	.footer__link {
		font-size: 14.5px;
		color: var(--color-text-secondary);
		overflow-wrap: anywhere;
		transition: color var(--transition-fast);
	}

	.footer__link:hover {
		color: var(--color-text);
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 72px;
		font-size: 13.5px;
		color: var(--color-muted);
	}

	.footer__powered a {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-border-strong);
		text-underline-offset: 3px;
		transition: text-decoration-color var(--transition-fast);
	}

	.footer__powered a:hover {
		text-decoration-color: currentColor;
	}

	.theme-switcher {
		display: inline-flex;
		padding: 3px;
		border-radius: var(--radius-full);
		background: var(--color-sunken);
	}

	.theme-btn {
		height: 28px;
		padding-block: 0;
		padding-inline: 12px;
		border: 0;
		border-radius: var(--radius-full);
		background: transparent;
		color: var(--color-text-secondary);
		font-family: inherit;
		font-size: 12.5px;
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.theme-btn:hover {
		color: var(--color-text);
	}

	.theme-btn[aria-pressed="true"] {
		background: var(--color-surface);
		color: var(--color-text);
		box-shadow: var(--shadow-card);
	}

	.footer__wordmark {
		margin-top: 40px;
		margin-bottom: -0.2em;
		font-family: var(--font-display);
		/* About 0.35em per letter, so 250vw / letters keeps a long title within the page */
		font-size: min(clamp(128px, 27vw, 440px), 250vw / var(--wordmark-length, 6));
		line-height: 0.8;
		letter-spacing: -0.045em;
		text-align: center;
		white-space: nowrap;
		color: transparent;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--color-text) 9%, transparent),
			color-mix(in srgb, var(--color-text) 2%, transparent) 75%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-user-select: none;
		user-select: none;
		pointer-events: none;
	}

	@media (max-width: 960px) {
		.footer__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-flow: row;
			gap: 40px 24px;
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (forced-colors: active) {
		.theme-btn[aria-pressed="true"] {
			outline: 1px solid CanvasText;
		}

		.footer__wordmark {
			display: none;
		}
	}
</style>
