---
// The site header: logo, the "primary" menu (items with the CSS class "button" become buttons)
// and the mobile menu. Data comes from Base.astro; menus are edited in the admin.
import { Icon } from "astro-iconset/components";
import type { MenuItem, SiteLogo } from "../utils/site";

interface Props {
	siteTitle: string;
	siteLogo: SiteLogo;
	menuItems: MenuItem[];
	isLoggedIn: boolean;
}

const { siteTitle, siteLogo, menuItems, isLoggedIn } = Astro.props;
const WHITESPACE = /\s+/;
const isButtonItem = (item: MenuItem) =>
	item.cssClasses?.split(WHITESPACE).includes("button") ?? false;
const navLinks = menuItems.filter((item) => !isButtonItem(item));
const navButtons = menuItems.filter(isButtonItem);
const panelButtons = navButtons.slice(1);
const hasMenuPanel = navLinks.length > 0 || panelButtons.length > 0 || isLoggedIn;
---

<header class="site-header">
	<div class="nav">
		<a href="/" class="nav__logo">
			{
				siteLogo ? (
					<img
						src={siteLogo.url}
						alt={siteLogo.alt || siteTitle}
						width={siteLogo.width}
						height={siteLogo.height}
						class="nav__logo-img"
					/>
				) : (
					siteTitle
				)
			}
		</a>
		{
			navLinks.length > 0 && (
				<nav class="nav__links" aria-label="Huvudmeny">
					{navLinks.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						>
							{item.label}
						</a>
					))}
				</nav>
			)
		}
		<div class="nav__actions">
			{isLoggedIn && <a href="/_emdash/admin" class="nav__admin">Admin</a>}
			{navButtons.map((item) => (
				<a
					href={item.url}
					target={item.target}
					rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
					class="btn btn-sm nav__cta"
				>
					{item.label}
				</a>
			))}
			{
				hasMenuPanel && (
					<button
						type="button"
						class="nav__menu-btn"
						aria-expanded="false"
						aria-controls="mobile-menu"
						aria-label="Meny"
					>
						<Icon name="ph:list" class="nav__menu-open" aria-hidden="true" />
						<Icon name="ph:x" class="nav__menu-close" aria-hidden="true" />
					</button>
				)
			}
		</div>
		{
			hasMenuPanel && (
				<nav id="mobile-menu" class="nav__panel" aria-label="Huvudmeny" hidden>
					{[...navLinks, ...panelButtons].map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						>
							{item.label}
						</a>
					))}
					{isLoggedIn && (
						<a href="/_emdash/admin" class="nav__panel-admin">
							Admin
						</a>
					)}
				</nav>
			)
		}
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const menuButton =
		header?.querySelector<HTMLButtonElement>(".nav__menu-btn");
	const menuPanel = header?.querySelector<HTMLElement>(".nav__panel");

	if (header && menuButton && menuPanel) {
		const setOpen = (open: boolean) => {
			menuButton.setAttribute("aria-expanded", String(open));
			menuPanel.hidden = !open;
		};

		menuButton.addEventListener("click", () =>
			setOpen(menuButton.getAttribute("aria-expanded") !== "true"),
		);

		menuPanel.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a")) {
				setOpen(false);
			}
		});

		document.addEventListener("click", (event) => {
			if (
				!menuPanel.hidden &&
				event.target instanceof Node &&
				!header.contains(event.target)
			) {
				setOpen(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || menuPanel.hidden) return;
			setOpen(false);
			menuButton.focus();
		});

		header.addEventListener("focusout", (event) => {
			if (
				event.relatedTarget instanceof Node &&
				!header.contains(event.relatedTarget)
			) {
				setOpen(false);
			}
		});

		window
			.matchMedia("(max-width: 960px)")
			.addEventListener("change", (event) => {
				if (!event.matches) setOpen(false);
			});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding-block-start: 12px;
		padding-inline: var(--sheet-inset);
		pointer-events: none;
	}

	.nav {
		position: relative;
		display: flex;
		align-items: center;
		gap: 36px;
		width: min(100%, var(--wide-width) + 40px);
		height: 60px;
		margin-inline: auto;
		padding-inline: 24px 10px;
		border-radius: var(--radius-full);
		background: var(--glass-bg);
		box-shadow: var(--shadow-glass);
		-webkit-backdrop-filter: saturate(1.6) blur(18px);
		backdrop-filter: saturate(1.6) blur(18px);
		pointer-events: auto;
	}

	.nav__logo {
		min-width: 0;
		overflow: hidden;
		font-family: var(--font-display);
		font-size: 28px;
		line-height: 1.2;
		letter-spacing: -0.01em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.nav__logo-img {
		width: auto;
		height: 32px;
		max-width: 180px;
		object-fit: contain;
	}

	.nav__links {
		display: flex;
		gap: 28px;
		font-size: 14.5px;
		color: var(--color-text-secondary);
	}

	.nav__links a {
		white-space: nowrap;
		transition: color var(--transition-fast);
	}

	.nav__links a:hover {
		color: var(--color-text);
	}

	.nav__actions {
		display: flex;
		flex: none;
		align-items: center;
		gap: 6px;
		margin-inline-start: auto;
	}

	.nav__admin {
		padding-inline: 10px;
		font-size: 14px;
		color: var(--color-muted);
		transition: color var(--transition-fast);
	}

	.nav__admin:hover {
		color: var(--color-text);
	}

	.nav__cta {
		white-space: nowrap;
	}

	.nav__menu-btn {
		display: none;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: inherit;
		font-size: 20px;
		cursor: pointer;
		transition: background-color var(--transition-fast);
	}

	.nav__menu-btn:hover,
	.nav__menu-btn[aria-expanded="true"] {
		background: var(--color-sunken);
	}

	.nav__menu-btn[aria-expanded="true"] .nav__menu-open,
	.nav__menu-btn[aria-expanded="false"] .nav__menu-close {
		display: none;
	}

	.nav__panel {
		position: absolute;
		inset-block-start: calc(100% + 8px);
		inset-inline: 0;
		display: none;
		max-height: calc(100dvh - 96px);
		overflow-y: auto;
		padding: 8px;
		border-radius: 26px;
		background: var(--color-surface);
		box-shadow: var(--shadow-glass);
	}

	.nav__panel a {
		display: flex;
		align-items: center;
		min-height: 48px;
		padding-inline: 18px;
		border-radius: 18px;
		font-size: 16px;
		transition: background-color var(--transition-fast);
	}

	.nav__panel a:hover {
		background: var(--color-sunken);
	}

	.nav__panel .nav__panel-admin {
		color: var(--color-muted);
	}

	@media (max-width: 960px) {
		.nav {
			gap: 16px;
			padding-inline-start: 20px;
		}

		.nav__links,
		.nav__admin,
		.nav__cta ~ .nav__cta {
			display: none;
		}

		.nav__menu-btn {
			display: grid;
		}

		.nav__panel:not([hidden]) {
			display: grid;
		}
	}
</style>
