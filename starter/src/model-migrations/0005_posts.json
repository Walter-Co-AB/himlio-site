{
	"version": "1",
	"collections": [
		{
			"slug": "posts",
			"label": "News",
			"labelSingular": "Post",
			"description": "News and posts, newest first. Show them on a page with a News section.",
			"urlPattern": {
				"en": "/news/{slug}",
				"sv": "/nyheter/{slug}"
			},
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"seo",
				"search"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt: a sentence or two for lists and sharing",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "image",
					"label": "Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Text",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"blockTypes": [
		{
			"slug": "marketing_posts",
			"label": "News",
			"description": "The latest posts from News, or all of them with pages",
			"icon": "newspaper",
			"category": "Marketing",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "headline",
							"label": "Headline",
							"type": "string"
						},
						{
							"slug": "eyebrow",
							"label": "Label above headline",
							"type": "string"
						},
						{
							"slug": "intro",
							"label": "Intro text (leave a blank line between paragraphs)",
							"type": "text"
						},
						{
							"slug": "mode",
							"label": "Show (Latest: the newest few; All: every post, with pages)",
							"type": "select",
							"defaultValue": "latest",
							"validation": {
								"options": [
									"latest",
									"all"
								]
							}
						},
						{
							"slug": "count",
							"label": "How many (Latest: 1–12; All: per page, up to 24)",
							"type": "number",
							"defaultValue": 3,
							"validation": {
								"min": 1,
								"max": 24
							}
						},
						{
							"slug": "link_label",
							"label": "Link to all posts: text (Latest only)",
							"type": "string"
						},
						{
							"slug": "link_url",
							"label": "Link to all posts: URL, e.g. /news",
							"type": "string"
						},
						{
							"slug": "anchor_id",
							"label": "Section ID (lowercase, for links like /#news)",
							"type": "string",
							"validation": {
								"pattern": "^(?:$|[a-z][a-z0-9_-]*)$"
							}
						}
					]
				}
			]
		}
	],
	"allowBlockTypes": [
		{
			"collection": "pages",
			"field": "content",
			"add": [
				"marketing_posts"
			]
		}
	]
}