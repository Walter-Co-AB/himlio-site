---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "@himlio/site/emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "@himlio/site/emdash/ui";
import { createPublicPageContext } from "@himlio/site/emdash/page";
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import { contactDetails, himlio } from "@himlio/site/runtime";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { resolveSiteIdentity } from "../utils/site";
import { t } from "../utils/strings";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/forms.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, robots, content } = Astro.props;
const [settingsResult, menuResult, footerProductResult, footerCompanyResult, footerSupportResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_product"),
		getMenuWithCacheHint("footer_company"),
		getMenuWithCacheHint("footer_support"),
	]);

if (Astro.cache?.enabled) {
	for (const result of [
		settingsResult,
		menuResult,
		footerProductResult,
		footerCompanyResult,
		footerSupportResult,
	]) {
		Astro.cache.set(result.cacheHint);
	}
}

// Contact details from the admin (Himlio's Company details), shown in the footer.
const contact = await contactDetails(Astro.cache);
const { siteTitle, siteTagline, siteLogo, titleSeparator } = resolveSiteIdentity(
	settingsResult.data,
);
const fullTitle = title
	? title.includes(siteTitle)
		? title
		: `${title} ${titleSeparator} ${siteTitle}`
	: siteTitle;
const menuItems = menuResult.data?.items ?? [];

const footerColumns = [footerProductResult, footerCompanyResult, footerSupportResult]
	.map((result) => ({ heading: result.data?.label, items: result.data?.items ?? [] }))
	.filter((column) => column.items.length > 0);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteTagline || undefined,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={himlio.locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">{t.skipToContent}</a>
		<Header {siteTitle} {siteLogo} {menuItems} {isLoggedIn} />

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<Footer {siteTitle} {siteTagline} {siteLogo} {contact} columns={footerColumns} />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
