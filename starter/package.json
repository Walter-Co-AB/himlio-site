    "verify": "npm run format:check && npm run check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@himlio/site": "1.1.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261115.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true,
    "esbuild@0.28.2": true
  }
}
