{
  "name": "himlio-starter",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "himlio-site dev",
    "build": "himlio-site build",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "himlio-site fixtures",
